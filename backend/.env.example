# Copy to .env and fill in. Never commit the real .env or the Google key file.

# Database (default: SQLite file in backend/data/). Production:
# DATABASE_URL=postgresql+psycopg://dashboard:CHANGE_ME@localhost:5432/dashboard

# Student roster
ROSTER_SHEET_URL=https://docs.google.com/spreadsheets/d/<sheet-id>/edit#gid=0
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Alerts (either or both)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard (API)
# generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
# true once the dashboard is served over HTTPS (also turns on HSTS)
COOKIE_SECURE=false
# development | staging | production (production hides the API docs at /api/docs)
APP_ENV=development
# other sites allowed to send change requests, comma-separated (normally empty)
# ALLOWED_ORIGINS=http://localhost:4173

# Worker: checks every minute inside this daily window (DISPLAY_TZ); outside it, it
# sleeps until the next job so the database can suspend ("always" = every minute, all day)
# WORKER_AWAKE_WINDOW=09:30-18:00
# the website's wake-up signal, so a sleeping worker hears about scan requests at once
# WORKER_WAKE_URL=https://nxtrank-nxtwave.onrender.com/api/worker/wake

# Optional
# PROXY_URL=http://user:pass@proxy-host:port
# DISPLAY_TZ=Asia/Kolkata
# SCAN_DELAY_MINUTES=30
# FINAL_SCAN_DAYS=4
