{
  "name": "contest-dashboard-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "NxtRank by NxtWave: LeetCode contest results, rankings and analytics (frontend)",
  "author": "Rajveer Sharma (NxtWave)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.3",
    "@dicebear/lorelei": "^9.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "puppeteer": "^23.11.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.5"
  }
}
