# Postgres settings for a small VM shared with the API.
# Put in /etc/postgresql/<version>/main/conf.d/dashboard.conf and restart Postgres.
# Sizes assume ~6 GB RAM for Postgres; scale with what the VM has.

listen_addresses = 'localhost'         # never reachable from the internet
max_connections = 50                   # 4 workers x (5 + 10 overflow) + worker + admin

shared_buffers = 1536MB                # ~25% of the RAM given to Postgres
effective_cache_size = 4GB             # what the OS will cache for us
work_mem = 16MB                        # per sort/hash; analytics queries sort a lot
maintenance_work_mem = 256MB
random_page_cost = 1.1                 # SSD / block storage

wal_compression = on
checkpoint_completion_target = 0.9

# See which queries are slow: SELECT * FROM pg_stat_statements ORDER BY total_exec_time DESC;
# (then run: CREATE EXTENSION pg_stat_statements; once in the database)
shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.track = top

log_min_duration_statement = 250ms     # log anything slower than the latency budget
