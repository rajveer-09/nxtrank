# /srv/dashboard/deploy/backup.env (chmod 600): settings for the backup timers
DB_NAME=dashboard
BACKUP_DIR=/srv/dashboard/backups
KEEP_DAYS=14
# OCI_BUCKET=dashboard-backups        # optional: also copy each dump to Object Storage
# NEON_URL=postgresql://...           # for dashboard-neon-copy: the Neon OFF-SITE copy (it is replaced weekly)
