# /etc/systemd/system/dashboard-neon-copy.service (run by dashboard-neon-copy.timer)
[Unit]
Description=NxtRank: weekly off-site copy of the database to Neon
After=postgresql.service

[Service]
Type=oneshot
User=dashboard
Group=dashboard
EnvironmentFile=-/srv/dashboard/deploy/backup.env
ExecStart=/srv/dashboard/deploy/copy-to-neon.sh
