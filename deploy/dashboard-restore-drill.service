# /etc/systemd/system/dashboard-restore-drill.service (run by dashboard-restore-drill.timer)
[Unit]
Description=NxtRank: monthly restore drill of the newest backup
After=postgresql.service

[Service]
Type=oneshot
User=dashboard
Group=dashboard
EnvironmentFile=-/srv/dashboard/deploy/backup.env
ExecStart=/srv/dashboard/deploy/restore-drill.sh
